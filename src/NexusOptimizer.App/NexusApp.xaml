<Application x:Class="NexusOptimizer.App.NexusApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.Dark.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
                <ResourceDictionary Source="Themes/Templates.xaml" />
                <ResourceDictionary Source="Themes/Shell.xaml" />
                <ResourceDictionary Source="Views/Pages.Overview.xaml" />
                <ResourceDictionary Source="Views/Pages.Hardware.xaml" />
                <ResourceDictionary Source="Views/Pages.System.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
