<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:NexusOptimizer.App.Controls"
                    xmlns:s="clr-namespace:NexusOptimizer.App.Services"
                    xmlns:vm="clr-namespace:NexusOptimizer.App.ViewModels">

    <!-- Seitenrahmen: DataContext = PageViewModel -->
    <Style TargetType="{x:Type c:PageLayout}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:PageLayout}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="32,22,32,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.PageSubtitle}" Visibility="{Binding Subtitle, Converter={StaticResource Vis}}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding HeaderContent}" ContentTemplate="{TemplateBinding HeaderContentTemplate}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="32,0,32,0">
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsLoading, Converter={StaticResource Vis}}" />
                            <Border Background="{DynamicResource Brush.RedSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="14,10" Margin="0,0,0,10"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <c:Icon Data="{StaticResource Icon.Warning}" Width="16" Height="16" Foreground="{DynamicResource Brush.Red}" Margin="0,1,10,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Brush.Red}" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="32,4,24,24">
                            <ContentPresenter />
                        </ScrollViewer>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Scrollable" Value="False">
                            <Setter TargetName="Scroller" Property="VerticalScrollBarVisibility" Value="Disabled" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Abschnittsüberschrift innerhalb einer Seite -->
    <Style x:Key="Text.Section" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Margin" Value="0,18,0,10" />
    </Style>

    <!-- Hinweiskasten (Ehrlichkeitshinweise, Einschränkungen) -->
    <Style x:Key="Card.Note" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style x:Key="Card.Warn" TargetType="Border" BasedOn="{StaticResource Card.Note}">
        <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
    </Style>

    <!-- Stapel von Karten mit gleichmäßigem Abstand -->
    <Style x:Key="Items.Cards" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="0,0,0,10" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Items.Wrap" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Symbol passend zur Dringlichkeit: Content = NotificationSeverity -->
    <DataTemplate x:Key="SeverityIcon">
        <c:Icon x:Name="Glyph" Data="{StaticResource Icon.Info}" Width="16" Height="16" Foreground="{DynamicResource Brush.Blue}" />
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="Success">
                <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Check}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Green}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Warning">
                <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Warning}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Amber}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Error">
                <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Warning}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Red}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Eingeblendeter Hinweis -->
    <DataTemplate DataType="{x:Type s:ToastViewModel}">
        <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}"
                Padding="14,12" Margin="0,8,0,0" Width="360">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding Severity}" ContentTemplate="{StaticResource SeverityIcon}" VerticalAlignment="Top" Margin="0,2,10,0" Focusable="False" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" Visibility="{Binding Message, Converter={StaticResource Vis}}" />
                    <Button Content="Anzeigen" Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Command="{Binding DataContext.OpenToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            Visibility="{Binding PageKey, Converter={StaticResource Vis}}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Button.Icon}" VerticalAlignment="Top" ToolTip="Schließen" AutomationProperties.Name="Hinweis schließen"
                        Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                    <c:Icon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                </Button>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Eintrag der Benachrichtigungsliste -->
    <DataTemplate DataType="{x:Type vm:NotificationViewModel}">
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl Content="{Binding Severity}" ContentTemplate="{StaticResource SeverityIcon}" VerticalAlignment="Top" Margin="0,2,10,0" Focusable="False" />
            <StackPanel Grid.Column="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
                    <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding Message, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsUnread}" Value="True">
                <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Suchtreffer -->
    <DataTemplate DataType="{x:Type vm:SearchResult}">
        <DockPanel Margin="0,1">
            <c:Icon Data="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0" Foreground="{DynamicResource Brush.TextSecondary}" />
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" />
            </StackPanel>
        </DockPanel>
    </DataTemplate>

    <!-- Navigationseintrag -->
    <DataTemplate DataType="{x:Type vm:NavItem}">
        <DockPanel>
            <Grid Width="17" Height="17" Margin="0,0,11,0">
                <c:Icon Data="{Binding Icon}" Width="17" Height="17" Visibility="{Binding HasImage, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                <Image Source="{Binding Image}" Width="17" Height="17" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasImage, Converter={StaticResource Vis}}" />
            </Grid>
            <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
        </DockPanel>
    </DataTemplate>
    <!-- Auswählbare Karte (Tag = True: ausgewählt) -->
    <Style x:Key="Button.Card" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Beschriftung über einem Eingabefeld -->
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <!-- Schritt eines Ablaufs -->
    <DataTemplate DataType="{x:Type vm:WorkflowStepViewModel}">
        <DockPanel Margin="0,0,14,10" ToolTip="{Binding Description}">
            <Border x:Name="Dot" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Brush.Track}" VerticalAlignment="Top" Margin="0,0,10,0">
                <Grid>
                    <TextBlock x:Name="Number" Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <c:Icon x:Name="Glyph" Data="{StaticResource Icon.Check}" Width="12" Height="12" Foreground="{DynamicResource Brush.Green}" Visibility="Collapsed" />
                </Grid>
            </Border>
            <StackPanel>
                <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" Visibility="{Binding Note, Converter={StaticResource Vis}}" />
            </StackPanel>
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding State}" Value="active">
                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Brush.Accent}" />
                <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="done">
                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="failed">
                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Brush.RedSoft}" />
                <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Warning}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Red}" />
                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Brush.Red}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="skipped">
                <Setter TargetName="Dot" Property="Opacity" Value="0.5" />
                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
