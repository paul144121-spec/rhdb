<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:NexusOptimizer.App.Controls"
                    xmlns:vm="clr-namespace:NexusOptimizer.App.ViewModels">

    <!-- Gemeinsame Bausteine -->
    <Style x:Key="Items.Tiles3" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,-12,0" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Items.Tiles4" TargetType="ItemsControl" BasedOn="{StaticResource Items.Tiles3}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Items.Sections" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,-12,0" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="0,0,12,0" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="RescanButton">
        <Button Command="{Binding RescanHardwareCommand}" ToolTip="Hardwareerkennung erneut ausführen">
            <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Refresh}" Width="14" Height="14" Margin="0,0,8,0" />
                <TextBlock Text="Neu erkennen" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Auslastung eines Kerns -->
    <DataTemplate DataType="{x:Type vm:CoreLoadViewModel}">
        <Grid Margin="0,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <!-- Energieeinstellung -->
    <DataTemplate DataType="{x:Type vm:PowerSettingItemViewModel}">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" Margin="0,0,10,4" TextWrapping="Wrap" />
                        <ContentControl Content="{Binding Risk}" ContentTemplate="{StaticResource RiskBadge}" Margin="0,0,6,4" Focusable="False" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" />
                    <TextBlock Text="{Binding CurrentText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Warning}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Amber}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasWarning, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding InputError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Red}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding InputError, Converter={StaticResource Vis}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,0,0" Width="300" Visibility="{Binding IsAvailable, Converter={StaticResource Vis}}">
                    <Grid Visibility="{Binding IsNumeric, Converter={StaticResource Vis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Netzbetrieb" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding AcInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" AutomationProperties.Name="Wert im Netzbetrieb" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Akkubetrieb" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding DcInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" AutomationProperties.Name="Wert im Akkubetrieb" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Visibility="{Binding HasChoices, Converter={StaticResource Vis}}">
                        <TextBlock Text="Netzbetrieb" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedAc}" DisplayMemberPath="Label" AutomationProperties.Name="Wert im Netzbetrieb" />
                        <TextBlock Text="Akkubetrieb" Style="{StaticResource Text.Label}" Margin="0,8,0,5" />
                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedDc}" DisplayMemberPath="Label" AutomationProperties.Name="Wert im Akkubetrieb" />
                    </StackPanel>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Anwenden" Command="{Binding ApplyCommand}" Style="{StaticResource Button.Accent}" ToolTip="Zeigt zuerst eine Vorschau der Änderung." />
                        <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextWrapping="Wrap">
                            <Run Text="{Binding UnitText, Mode=OneWay}" /><LineBreak /><Run Text="{Binding RangeText, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ───────── Prozessor ───────── -->
    <DataTemplate DataType="{x:Type vm:CpuViewModel}">
        <c:PageLayout HeaderContentTemplate="{StaticResource RescanButton}" HeaderContent="{Binding}">
            <StackPanel>
                <Border Style="{StaticResource Card.Warn}" Margin="0,0,0,12" Visibility="{Binding IsThrottled, Converter={StaticResource Vis}}">
                    <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"
                               Text="Die Prozessorleistung wird derzeit begrenzt (thermisch, durch die Firmware oder durch den Energieplan). Leistungsorientierte Einstellungen würden daran nichts verbessern – prüfen Sie Kühlung und Luftwege." />
                </Border>
                <ItemsControl ItemsSource="{Binding Tiles}" Style="{StaticResource Items.Tiles4}" />

                <TextBlock Text="Auslastung je logischem Prozessor" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Cores}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="Die Auslastung je Kern wird von diesem System nicht gemeldet." Style="{StaticResource Text.Secondary}" Visibility="{Binding Cores.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Weitere Live-Werte" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding LiveRows}" Focusable="False" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Prozesse öffnen" Style="{StaticResource Button.Link}" Command="{Binding OpenCommand}" CommandParameter="processes" />
                                <TextBlock Text="Höchste CPU-Last" Style="{StaticResource Text.CardTitle}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding TopProcesses}" Focusable="False" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ItemsControl ItemsSource="{Binding Sections}" Style="{StaticResource Items.Sections}" />

                <TextBlock Text="Prozessorbezogene Energieeinstellungen" Style="{StaticResource Text.Section}" />
                <TextBlock Text="{Binding ActivePlan}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding PowerSettings}" Focusable="False" />

                <TextBlock Text="Weitere Einstellungen" Style="{StaticResource Text.Section}" Visibility="{Binding HasTweaks, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding Tweaks}" Focusable="False" />
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- ───────── Grafik ───────── -->
    <DataTemplate DataType="{x:Type vm:GpuViewModel}">
        <c:PageLayout HeaderContentTemplate="{StaticResource RescanButton}" HeaderContent="{Binding}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Tiles}" Style="{StaticResource Items.Tiles3}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Weitere Live-Werte" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding LiveRows}" Focusable="False" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Sections}" Style="{StaticResource Items.Sections}" />

                <Border Style="{StaticResource Card}" Visibility="{Binding DriverLinks.Count, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="Treiber" Style="{StaticResource Text.CardTitle}" />
                        <TextBlock Text="Diese Anwendung installiert keine Treiber und lädt keine herunter. Aktuelle Treiber erhalten Sie ausschließlich beim Hersteller oder über Windows Update." Style="{StaticResource Text.Secondary}" Margin="0,6,0,8" />
                        <ItemsControl ItemsSource="{Binding DriverLinks}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="0,2" ToolTip="{Binding Value}"
                                            Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Value}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" />
                                            <c:Icon Data="{StaticResource Icon.External}" Width="12" Height="12" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="GPU-Zuordnung je Anwendung" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Legt für ein Programm fest, welche Grafikeinheit Windows bevorzugt (entspricht „Einstellungen › Anzeige › Grafik“). Auf Systemen mit nur einer GPU hat die Einstellung keine Wirkung." Style="{StaticResource Text.Secondary}" Margin="0,0,0,10" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Anwenden" Command="{Binding ApplyPreferenceCommand}" Style="{StaticResource Button.Accent}" Margin="8,0,0,0" />
                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Preferences}" SelectedItem="{Binding SelectedPreference}" DisplayMemberPath="Label" Width="300" Margin="8,0,0,0" AutomationProperties.Name="GPU-Präferenz" />
                            <Button DockPanel.Dock="Right" Content="Durchsuchen …" Command="{Binding BrowseAppCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding AppPath, UpdateSourceTrigger=PropertyChanged}" Tag="Vollständiger Pfad zur Programmdatei (.exe)" MaxLength="260" AutomationProperties.Name="Programmpfad" />
                        </DockPanel>
                        <TextBlock Text="{Binding PreferenceError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Red}" Margin="0,6,0,0" Visibility="{Binding PreferenceError, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Grafik- und Spieleeinstellungen von Windows" Style="{StaticResource Text.Section}" Visibility="{Binding HasTweaks, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding Tweaks}" Focusable="False" />
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- ───────── Arbeitsspeicher ───────── -->
    <DataTemplate DataType="{x:Type vm:RamViewModel}">
        <c:PageLayout HeaderContentTemplate="{StaticResource RescanButton}" HeaderContent="{Binding}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Tiles}" Style="{StaticResource Items.Tiles3}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Zusammensetzung" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding LiveRows}" Focusable="False" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Prozesse öffnen" Style="{StaticResource Button.Link}" Command="{Binding OpenCommand}" CommandParameter="processes" />
                                <TextBlock Text="Größte Speicherverbraucher" Style="{StaticResource Text.CardTitle}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding TopProcesses}" Focusable="False" />
                        </StackPanel>
                    </Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding Sections}" Style="{StaticResource Items.Sections}" />
                <TextBlock Text="Speicherbezogene Einstellungen" Style="{StaticResource Text.Section}" Visibility="{Binding HasTweaks, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding Tweaks}" Focusable="False" />
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- Volume -->
    <DataTemplate DataType="{x:Type vm:VolumeViewModel}">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock Text="{Binding MediaText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,8" />
                    <ProgressBar x:Name="Usage" Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="8" />
                    <TextBlock Text="{Binding UsageText}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button Content="Optimieren" Command="{Binding OptimizeCommand}" Margin="0,0,8,0" ToolTip="Windows wählt das Verfahren passend zum Medium: TRIM für SSDs, Defragmentierung nur für Festplatten." />
                    <Button Content="TRIM senden" Command="{Binding RetrimCommand}" Margin="0,0,8,0" Visibility="{Binding IsSolidState, Converter={StaticResource Vis}}" />
                    <Button Content="Dateisystem prüfen" Command="{Binding CheckCommand}" ToolTip="Nur lesende Online-Prüfung (CHKDSK /scan). Es wird nichts repariert." />
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsLow}" Value="True">
                <Setter TargetName="Usage" Property="Foreground" Value="{DynamicResource Brush.Amber}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ───────── Datenträger ───────── -->
    <DataTemplate DataType="{x:Type vm:StorageViewModel}">
        <c:PageLayout HeaderContentTemplate="{StaticResource RescanButton}" HeaderContent="{Binding}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Tiles}" Style="{StaticResource Items.Tiles3}" />

                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Zur Bereinigung" Style="{StaticResource Button.Link}" Command="{Binding OpenCommand}" CommandParameter="cleanup" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="Laufwerke" Style="{StaticResource Text.Section}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Volumes}" Focusable="False" />
                <ItemsControl ItemsSource="{Binding Sections}" Style="{StaticResource Items.Sections}" />

                <TextBlock Text="Große Dateien und Duplikate finden" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Abbrechen" Command="{Binding CancelScanCommand}" Margin="8,0,0,0" Visibility="{Binding IsScanning, Converter={StaticResource Vis}}" />
                            <Button DockPanel.Dock="Right" Content="Duplikate suchen" Command="{Binding FindDuplicatesCommand}" Margin="8,0,0,0" IsEnabled="{Binding IsScanning, Converter={StaticResource Not}}" />
                            <Button DockPanel.Dock="Right" Content="Große Dateien suchen" Command="{Binding FindLargeFilesCommand}" Style="{StaticResource Button.Accent}" Margin="8,0,0,0" IsEnabled="{Binding IsScanning, Converter={StaticResource Not}}" />
                            <Button DockPanel.Dock="Right" Content="Ordner wählen …" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding ScanFolder, UpdateSourceTrigger=PropertyChanged}" MaxLength="260" AutomationProperties.Name="Ordner für die Suche" />
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="{Binding IsScanning, Converter={StaticResource Vis}}" />
                        <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" />

                        <ItemsControl ItemsSource="{Binding LargeFiles}" Margin="0,10,0,0" Focusable="False" Visibility="{Binding LargeFiles.Count, Converter={StaticResource Vis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Size}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Modified}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Path}" Style="{StaticResource Text.Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        <Button Grid.Column="3" Content="Im Explorer zeigen" Style="{StaticResource Button.Link}" Margin="12,0,0,0"
                                                Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=c:PageLayout}}" CommandParameter="{Binding Path}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Duplicates}" Margin="0,10,0,0" Focusable="False" Visibility="{Binding Duplicates.Count, Converter={StaticResource Vis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Summary}" Margin="0,2">
                                        <ItemsControl ItemsSource="{Binding Paths}" Focusable="False" Margin="0,4,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2">
                                                        <Button DockPanel.Dock="Right" Content="Im Explorer zeigen" Style="{StaticResource Button.Link}" Margin="12,0,0,0"
                                                                Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=c:PageLayout}}" CommandParameter="{Binding}" />
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="Speicherbezogene Einstellungen" Style="{StaticResource Text.Section}" Visibility="{Binding HasTweaks, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding Tweaks}" Focusable="False" />
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- ───────── Netzwerk ───────── -->
    <DataTemplate DataType="{x:Type vm:NetworkViewModel}">
        <c:PageLayout HeaderContentTemplate="{StaticResource RescanButton}" HeaderContent="{Binding}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False" Margin="0,0,-12,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Sections}" Style="{StaticResource Items.Sections}" />

                <TextBlock Text="DNS-Server" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Ein anderer DNS-Server beschleunigt nur die Namensauflösung – nicht die Download-Geschwindigkeit und in der Regel auch nicht den Ping in Spielen. Die bisherige Konfiguration wird gesichert und lässt sich wiederherstellen." Style="{StaticResource Text.Secondary}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Adapter" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding DnsAdapters}" SelectedItem="{Binding SelectedDnsAdapter}" DisplayMemberPath="Label" AutomationProperties.Name="Netzwerkadapter" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DNS-Server" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding DnsPresets}" SelectedItem="{Binding SelectedDnsPreset}" DisplayMemberPath="Label" AutomationProperties.Name="DNS-Vorgabe" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="Anwenden" Command="{Binding ApplyDnsCommand}" Style="{StaticResource Button.Accent}" VerticalAlignment="Bottom" Margin="10,0,0,0" />
                        </Grid>
                        <TextBox Text="{Binding CustomDns, UpdateSourceTrigger=PropertyChanged}" Tag="IPv4-Adressen, durch Komma getrennt – z. B. 192.168.1.1, 1.1.1.1" Margin="0,10,0,0" MaxLength="80"
                                 Visibility="{Binding IsCustomDns, Converter={StaticResource Vis}}" AutomationProperties.Name="Eigene DNS-Server" />
                        <TextBlock Text="{Binding DnsCurrent}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DnsError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Red}" Margin="0,4,0,0" Visibility="{Binding DnsError, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Diagnose" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Abbrechen" Command="{Binding CancelDiagnosticCommand}" Margin="8,0,0,0" Visibility="{Binding IsDiagnosing, Converter={StaticResource Vis}}" />
                            <Button DockPanel.Dock="Right" Content="DNS-Zeit messen" Command="{Binding MeasureDnsCommand}" Margin="8,0,0,0" IsEnabled="{Binding IsDiagnosing, Converter={StaticResource Not}}" />
                            <Button DockPanel.Dock="Right" Content="Route verfolgen" Command="{Binding TracerouteCommand}" Margin="8,0,0,0" IsEnabled="{Binding IsDiagnosing, Converter={StaticResource Not}}" />
                            <Button DockPanel.Dock="Right" Content="Ping" Command="{Binding PingCommand}" Style="{StaticResource Button.Accent}" Margin="8,0,0,0" IsEnabled="{Binding IsDiagnosing, Converter={StaticResource Not}}" />
                            <TextBox Text="{Binding DiagnosticTarget, UpdateSourceTrigger=PropertyChanged}" Tag="Hostname oder IP-Adresse" MaxLength="253" AutomationProperties.Name="Ziel der Diagnose" />
                        </DockPanel>
                        <Border Style="{StaticResource Card.Inset}" Margin="0,10,0,0" Visibility="{Binding DiagnosticLines.Count, Converter={StaticResource Vis}}">
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" c:Attach.AutoScroll="True">
                                <ItemsControl ItemsSource="{Binding DiagnosticLines}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="Reparaturwerkzeuge" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="DNS-Cache leeren" Command="{Binding FlushDnsCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="Verwirft zwischengespeicherte Namensauflösungen. Hilft, wenn eine Website nach einem Serverumzug nicht erreichbar ist. Unbedenklich; der Cache füllt sich von selbst wieder." />
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Winsock zurücksetzen" Command="{Binding ResetWinsockCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="Setzt den Winsock-Katalog auf den Auslieferungszustand zurück. Nur bei tatsächlichen Verbindungsproblemen sinnvoll: nicht umkehrbar, erfordert Administratorrechte und einen Neustart; VPN- oder Sicherheitssoftware muss ggf. neu eingerichtet werden." />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Netzwerkbezogene Einstellungen" Style="{StaticResource Text.Section}" Visibility="{Binding HasTweaks, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding Tweaks}" Focusable="False" />
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- Energieplan -->
    <DataTemplate DataType="{x:Type vm:PowerPlanViewModel}">
        <Border x:Name="Root" Style="{StaticResource Card}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Aktivieren" Command="{Binding ActivateCommand}" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="{Binding CanActivate, Converter={StaticResource Vis}}" />
                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{DynamicResource Brush.GreenSoft}" Margin="16,0,0,0" Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                    <TextBlock Text="Aktiv" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Green}" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" Visibility="{Binding Hint, Converter={StaticResource Vis}}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ───────── Energieverwaltung ───────── -->
    <DataTemplate DataType="{x:Type vm:PowerViewModel}">
        <c:PageLayout>
            <c:PageLayout.HeaderContent>
                <Button Command="{Binding OpenWindowsPowerSettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Windows-Energieeinstellungen" />
                        <c:Icon Data="{StaticResource Icon.External}" Width="13" Height="13" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </c:PageLayout.HeaderContent>
            <StackPanel>
                <Border Style="{StaticResource Card.Note}" Margin="0,0,0,12">
                    <DockPanel>
                        <c:Icon Data="{StaticResource Icon.Battery}" Width="16" Height="16" Foreground="{DynamicResource Brush.Blue}" Margin="0,1,10,0" />
                        <TextBlock Text="{Binding SupplyText}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <TextBlock Text="Energiepläne" Style="{StaticResource Text.Section}" Margin="0,4,0,10" />
                <ItemsControl ItemsSource="{Binding Plans}" Focusable="False" />
                <TextBlock Text="{Binding PlansNote}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,10" Visibility="{Binding PlansNote, Converter={StaticResource Vis}}" />

                <ItemsControl ItemsSource="{Binding Sections}" Style="{StaticResource Items.Sections}" />

                <TextBlock Text="Einstellungen des aktiven Plans" Style="{StaticResource Text.Section}" />
                <ItemsControl ItemsSource="{Binding Settings}" Focusable="False" />

                <TextBlock Text="Weitere energiebezogene Einstellungen" Style="{StaticResource Text.Section}" Visibility="{Binding HasTweaks, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding Tweaks}" Focusable="False" />
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>
</ResourceDictionary>
