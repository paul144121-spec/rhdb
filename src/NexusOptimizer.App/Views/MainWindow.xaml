<Window x:Class="NexusOptimizer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NexusOptimizer.App.Controls"
        Title="NEXUS Optimizer AI" Width="1360" Height="860" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" Icon="/Assets/nexus.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{DynamicResource Brush.Window}">
        <Grid x:Name="RootGrid">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding FontScale}" ScaleY="{Binding FontScale}" />
            </Grid.LayoutTransform>

            <!-- ───────── Anwendung ───────── -->
            <Grid x:Name="AppArea" IsEnabled="{Binding State.ActiveDialog, Converter={StaticResource IsNull}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Seitenleiste -->
                <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,11,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource Color.Accent}" Offset="0" />
                                        <GradientStop Color="{DynamicResource Color.Cyan}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <c:Icon Data="{StaticResource Icon.Bolt}" Width="16" Height="16" Foreground="White" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="NEXUS" FontFamily="{StaticResource Font.Display}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
                                <TextBlock Text="Optimizer AI" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,-2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <ListBox x:Name="NavList" Grid.Row="1" ItemsSource="{Binding NavView}" SelectedItem="{Binding SelectedNav}" Style="{StaticResource List.Plain}"
                                 ItemContainerStyle="{StaticResource ListItem.Nav}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Navigation"
                                 WindowChrome.IsHitTestVisibleInChrome="True">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextTertiary}" Margin="20,14,0,5" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>

                        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,10" ToolTip="{Binding PrivilegeHint}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource Icon.Lock}" Width="13" Height="13" Margin="0,0,7,0" Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBlock Text="{Binding PrivilegeText}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" />
                                </StackPanel>
                                <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" Margin="20,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Hauptbereich -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Titelleiste -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="SearchHost" Width="380" HorizontalAlignment="Left" Margin="32,7,0,7" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Suchen: Bereiche und Einstellungen (Strg+K)" Padding="32,0,10,0"
                                     AutomationProperties.Name="Globale Suche" MaxLength="80" />
                            <c:Icon Data="{StaticResource Icon.Search}" Width="14" Height="14" HorizontalAlignment="Left" Margin="11,0,0,0" Foreground="{DynamicResource Brush.TextTertiary}" IsHitTestVisible="False" />
                        </Grid>
                        <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Command="{Binding ToggleNotificationsCommand}" ToolTip="Benachrichtigungen" Margin="0,0,10,0"
                                AutomationProperties.Name="Benachrichtigungen" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                            <Grid>
                                <c:Icon Data="{StaticResource Icon.Bell}" Width="17" Height="17" />
                                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Brush.Red}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                        Visibility="{Binding HasUnread, Converter={StaticResource Vis}}" />
                            </Grid>
                        </Button>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource Button.Caption}" Click="OnMinimize" ToolTip="Minimieren" AutomationProperties.Name="Minimieren">
                                <c:Icon Data="{StaticResource Icon.Minimize}" Width="12" Height="12" />
                            </Button>
                            <Button Style="{StaticResource Button.Caption}" Click="OnMaximize" ToolTip="Maximieren oder verkleinern" AutomationProperties.Name="Maximieren">
                                <c:Icon x:Name="MaximizeIcon" Data="{StaticResource Icon.Maximize}" Width="12" Height="12" />
                            </Button>
                            <Button Style="{StaticResource Button.Caption.Close}" Click="OnClose" ToolTip="Schließen" AutomationProperties.Name="Schließen">
                                <c:Icon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Seiteninhalt -->
                    <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />

                    <!-- Suchtreffer -->
                    <Border Grid.Row="1" Width="380" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,-2,0,0" Background="{DynamicResource Brush.Card}"
                            BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="4"
                            Visibility="{Binding IsSearchOpen, Converter={StaticResource Vis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="Black" />
                        </Border.Effect>
                        <ListBox x:Name="SearchList" ItemsSource="{Binding SearchResults}" Style="{StaticResource List.Plain}" ItemContainerStyle="{StaticResource ListItem.Row}" MaxHeight="420"
                                 PreviewMouseLeftButtonUp="OnSearchResultClick" KeyDown="OnSearchListKeyDown" AutomationProperties.Name="Suchtreffer" />
                    </Border>

                    <!-- Benachrichtigungen -->
                    <Border Grid.Row="1" Width="400" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,24,0" Background="{DynamicResource Brush.Card}"
                            BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="14"
                            Visibility="{Binding IsNotificationsOpen, Converter={StaticResource Vis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="Black" />
                        </Border.Effect>
                        <Grid MaxHeight="520">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Leeren" Style="{StaticResource Button.Link}" Command="{Binding ClearNotificationsCommand}" />
                                <Button DockPanel.Dock="Right" Content="Alle gelesen" Style="{StaticResource Button.Link}" Command="{Binding MarkNotificationsReadCommand}" Margin="0,0,14,0" />
                                <TextBlock Text="Benachrichtigungen" Style="{StaticResource Text.CardTitle}" />
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="Keine Benachrichtigungen." Style="{StaticResource Text.Secondary}" Margin="0,8"
                                       Visibility="{Binding Notifications.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding Notifications}" Style="{StaticResource List.Plain}" ItemContainerStyle="{StaticResource ListItem.Row}"
                                     PreviewMouseLeftButtonUp="OnNotificationClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Benachrichtigungsliste" />
                        </Grid>
                    </Border>

                    <!-- Hinweise -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding State.Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,20" Focusable="False" />
                </Grid>
            </Grid>

            <!-- ───────── Dialogebene ───────── -->
            <Grid x:Name="DialogLayer" Background="{DynamicResource Brush.Overlay}" Visibility="{Binding State.ActiveDialog, Converter={StaticResource Vis}}"
                  KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="12" Padding="26"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.45" Color="Black" />
                    </Border.Effect>
                    <ContentControl x:Name="DialogHost" Content="{Binding State.ActiveDialog}" Focusable="False" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
