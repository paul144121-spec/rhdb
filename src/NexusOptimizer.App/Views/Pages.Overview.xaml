<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:NexusOptimizer.App.Controls"
                    xmlns:vm="clr-namespace:NexusOptimizer.App.ViewModels">

    <!-- ───────── Dashboard ───────── -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <c:PageLayout>
            <c:PageLayout.HeaderContent>
                <Button Command="{Binding RefreshCommand}" ToolTip="Analyse erneut ausführen (liest nur Daten)">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Refresh}" Width="14" Height="14" Margin="0,0,8,0" />
                        <TextBlock Text="Neu analysieren" />
                    </StackPanel>
                </Button>
            </c:PageLayout.HeaderContent>
            <StackPanel>
                <!-- Zustand und Einstieg -->
                <Border Style="{StaticResource Card}" Padding="24,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="HealthDot" Width="46" Height="46" CornerRadius="23" Background="{DynamicResource Brush.BlueSoft}" VerticalAlignment="Top" Margin="0,2,18,0">
                            <c:Icon x:Name="HealthIcon" Data="{StaticResource Icon.Info}" Width="22" Height="22" Foreground="{DynamicResource Brush.Blue}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HealthTitle}" FontFamily="{StaticResource Font.Display}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HealthDetail}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SystemSummary}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding SystemSummary, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0,0,0">
                            <Button Style="{StaticResource Button.Hero}" Command="{Binding OptimizeNowCommand}" AutomationProperties.Name="Jetzt optimieren"
                                    ToolTip="Analysiert das System und zeigt eine Vorschau. Es wird nichts geändert, bevor Sie zustimmen.">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource Icon.Bolt}" Width="18" Height="18" Margin="0,0,10,0" />
                                    <TextBlock Text="Jetzt optimieren" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Erst Analyse und Vorschau – dann entscheiden Sie." Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Hinweise -->
                <ItemsControl ItemsSource="{Binding Notices}" Focusable="False" Margin="0,10,0,0" Visibility="{Binding HasNotices, Converter={StaticResource Vis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card.Warn}" Margin="0,0,0,6">
                                <DockPanel>
                                    <c:Icon Data="{StaticResource Icon.Warning}" Width="15" Height="15" Foreground="{DynamicResource Brush.Amber}" Margin="0,1,10,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Live-Werte -->
                <DockPanel Margin="0,8,0,0">
                    <Expander DockPanel.Dock="Right" Header="Kacheln anpassen" VerticalAlignment="Center" Margin="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding TileOptions}" Style="{StaticResource Items.Wrap}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Title}" IsChecked="{Binding IsVisible}" Margin="0,0,16,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <TextBlock Text="Live-Messwerte" Style="{StaticResource Text.Section}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False" Margin="0,0,-12,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Kurzinfos -->
                <UniformGrid Columns="3" Margin="0,4,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Aktives Profil" Style="{StaticResource Text.Secondary}" />
                            <TextBlock Text="{Binding ActiveProfile}" Style="{StaticResource Text.CardTitle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PowerSummary}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <Button Content="Profile öffnen" Style="{StaticResource Button.Link}" Command="{Binding OpenCommand}" CommandParameter="profiles" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Letzte aktive Änderung" Style="{StaticResource Text.Secondary}" />
                            <TextBlock Text="{Binding LastChangeTitle}" Style="{StaticResource Text.CardTitle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LastChangeDetail}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Command="{Binding UndoLastCommand}" IsEnabled="{Binding CanUndoLast}" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Data="{StaticResource Icon.Undo}" Width="14" Height="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Letzte Änderung rückgängig machen" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Betriebszeit seit dem Start" Style="{StaticResource Text.Secondary}" />
                            <TextBlock Text="{Binding Uptime}" Style="{StaticResource Text.CardTitle}" Margin="0,4,0,0" />
                            <TextBlock Text="Der Verlauf zeigt jede Änderung mit Ausgangswert, Zielwert und Prüfergebnis." Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <Button Content="Optimierungsverlauf anzeigen" Style="{StaticResource Button.Link}" Command="{Binding OpenCommand}" CommandParameter="history" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Empfehlungen -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Alle Empfehlungen anzeigen" Style="{StaticResource Button.Link}" Command="{Binding OpenCommand}" CommandParameter="ai" VerticalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RecommendationSummary}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,10,14,0" />
                    <TextBlock Text="Wichtigste Empfehlungen" Style="{StaticResource Text.Section}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Recommendations}" Style="{StaticResource Items.Cards}" />
                <Border Style="{StaticResource Card}" Visibility="{Binding HasRecommendations, Converter={StaticResource Vis}, ConverterParameter=invert}">
                    <TextBlock Text="Derzeit liegen keine Empfehlungen vor. Die Analyse ist regelbasiert und beruht ausschließlich auf gemessenen Werten dieses Systems." Style="{StaticResource Text.Secondary}" />
                </Border>
            </StackPanel>
        </c:PageLayout>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HealthLevel}" Value="ok">
                <Setter TargetName="HealthDot" Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                <Setter TargetName="HealthIcon" Property="Foreground" Value="{DynamicResource Brush.Green}" />
                <Setter TargetName="HealthIcon" Property="Data" Value="{StaticResource Icon.Check}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HealthLevel}" Value="warn">
                <Setter TargetName="HealthDot" Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                <Setter TargetName="HealthIcon" Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                <Setter TargetName="HealthIcon" Property="Data" Value="{StaticResource Icon.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HealthLevel}" Value="critical">
                <Setter TargetName="HealthDot" Property="Background" Value="{DynamicResource Brush.RedSoft}" />
                <Setter TargetName="HealthIcon" Property="Foreground" Value="{DynamicResource Brush.Red}" />
                <Setter TargetName="HealthIcon" Property="Data" Value="{StaticResource Icon.Warning}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <!-- ───────── Ein-Klick-Optimierung ───────── -->
    <DataTemplate DataType="{x:Type vm:OneClickViewModel}">
        <c:PageLayout>
            <StackPanel>
                <TextBlock Text="1 · Modus wählen" Style="{StaticResource Text.Section}" Margin="0,4,0,10" />
                <ItemsControl ItemsSource="{Binding Modes}" Focusable="False" Margin="0,0,-12,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.Card}" Tag="{Binding IsSelected}" Margin="0,0,12,12" AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.SelectModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" TextWrapping="Wrap" />
                                    <ContentControl Content="{Binding HighestRisk}" ContentTemplate="{StaticResource RiskBadge}" HorizontalAlignment="Left" Margin="0,6,0,0" Focusable="False" ToolTip="Höchste Risikostufe, die in diesem Modus vorkommen kann" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Padding="22,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedMode.Name}" FontFamily="{StaticResource Font.Display}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            <ItemsControl ItemsSource="{Binding SelectedMode.Points}" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <c:Icon Data="{StaticResource Icon.Check}" Width="13" Height="13" Foreground="{DynamicResource Brush.Green}" Margin="0,2,8,0" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Secondary}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource Card.Warn}" Margin="0,10,0,0" Visibility="{Binding SelectedMode.Warning, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding SelectedMode.Warning}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                            </Border>
                            <Border Style="{StaticResource Card.Warn}" Margin="0,10,0,0" Visibility="{Binding ExperimentalLocked, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="Der experimentelle Modus ist gesperrt. Schalten Sie zuerst das Expertenlabor frei – ohne Freischaltung verwirft der Planer alle experimentellen Änderungen." FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                                    <Button Content="Zum Expertenlabor" Style="{StaticResource Button.Link}" Command="{Binding OpenCommand}" CommandParameter="advanced" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center" Width="270">
                            <Button Style="{StaticResource Button.Hero}" Command="{Binding OptimizeCommand}" AutomationProperties.Name="Jetzt optimieren">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource Icon.Bolt}" Width="18" Height="18" Margin="0,0,10,0" />
                                    <TextBlock Text="Jetzt optimieren" />
                                </StackPanel>
                            </Button>
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="ResultCard" Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock x:Name="ResultTitle" Text="{Binding ResultTitle}" FontFamily="{StaticResource Font.Display}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                        <ItemsControl ItemsSource="{Binding ResultLines}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Text.Secondary}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Command="{Binding UndoRunCommand}" Margin="0,0,8,0" Visibility="{Binding CanUndoRun, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource Icon.Undo}" Width="14" Height="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Diesen Lauf rückgängig machen" />
                                </StackPanel>
                            </Button>
                            <Button Content="Optimierungsverlauf anzeigen" Command="{Binding OpenCommand}" CommandParameter="history" Margin="0,0,8,0" />
                            <Button Content="Wirkung im Benchmark-Center messen" Command="{Binding OpenCommand}" CommandParameter="benchmark" Style="{StaticResource Button.Subtle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="2 · Ablauf" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </c:PageLayout>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ResultLevel}" Value="ok">
                <Setter TargetName="ResultTitle" Property="Foreground" Value="{DynamicResource Brush.Green}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ResultLevel}" Value="warn">
                <Setter TargetName="ResultTitle" Property="Foreground" Value="{DynamicResource Brush.Amber}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ───────── KI-Optimierer ───────── -->
    <DataTemplate DataType="{x:Type vm:AiOptimizerViewModel}">
        <c:PageLayout>
            <c:PageLayout.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Bericht exportieren" Command="{Binding ExportCommand}" Margin="0,0,8,0" />
                    <Button Command="{Binding AnalyzeCommand}" Style="{StaticResource Button.Accent}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Sparkle}" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="Analyse starten" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageLayout.HeaderContent>
            <StackPanel>
                <Border Style="{StaticResource Card.Note}" Margin="0,0,0,12">
                    <DockPanel>
                        <c:Icon Data="{StaticResource Icon.Info}" Width="16" Height="16" Foreground="{DynamicResource Brush.Blue}" Margin="0,1,10,0" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="{Binding EngineDescription}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="{Binding ProviderNote}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Optimierungsziel" Style="{StaticResource Text.Label}" />
                            <ComboBox ItemsSource="{Binding Goals}" SelectedItem="{Binding SelectedGoal}" DisplayMemberPath="Label" AutomationProperties.Name="Optimierungsziel" />
                            <TextBlock Text="Das Ziel bestimmt, welche Regeln greifen und wie Zielkonflikte (z. B. Leistung gegen Lautstärke) gewichtet werden." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Betriebsart" Style="{StaticResource Text.Label}" />
                            <ComboBox ItemsSource="{Binding AiModes}" SelectedItem="{Binding SelectedAiMode}" DisplayMemberPath="Label" AutomationProperties.Name="Betriebsart" />
                            <TextBlock Text="Außer im Automatikmodus wird jede Änderung erst nach Vorschau und Bestätigung ausgeführt." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Visibility="{Binding IsAutoMode, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Jetzt einen Lauf ausführen" Command="{Binding RunAutoNowCommand}" IsEnabled="{Binding AutoEnabled}" />
                            <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding AutoEnabled}" Content="Automatikmodus (unbeaufsichtigte Ausführung)" />
                        </DockPanel>
                        <TextBlock Text="{Binding AutoLimits}" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding AutoStatus}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <Button Content="Freigaben in den Einstellungen anpassen" Style="{StaticResource Button.Link}" Command="{Binding OpenCommand}" CommandParameter="settings" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Alle empfohlenen Änderungen prüfen" Command="{Binding ApplyAllCommand}" Visibility="{Binding CanApplyAll, Converter={StaticResource Vis}}" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="Empfehlungen" Style="{StaticResource Text.Section}" />
                </DockPanel>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Recommendations}" Style="{StaticResource Items.Cards}" />

                <TextBlock Text="Rückmeldungen (Lernmodus)" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="Hier findet kein maschinelles Lernen statt. Gespeichert werden ausschließlich Ihre Entscheidungen und gemessene Ergebnisse aus Tuning-Experimenten. Abgelehnte oder als nachteilig gemessene Änderungen werden nicht erneut vorgeschlagen. Risikofreigaben ändern sich dadurch nie." />
                        <ItemsControl ItemsSource="{Binding Learning}" Margin="0,10,0,0" Focusable="False" />
                        <Button Content="Rückmeldungen löschen" Command="{Binding ResetLearningCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- Warnregel -->
    <DataTemplate DataType="{x:Type vm:AlertRuleViewModel}">
        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding Enabled}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Text="{Binding MetricName}" Style="{StaticResource Text.Caption}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ComparisonText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding Threshold, UpdateSourceTrigger=LostFocus, StringFormat='0.#'}" Width="70" AutomationProperties.Name="Schwelle" />
                <TextBlock Text="{Binding UnitText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="6,0,14,0" MinWidth="24" />
                <TextBlock Text="für mindestens" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding SustainSeconds, UpdateSourceTrigger=LostFocus}" Width="60" AutomationProperties.Name="Mindestdauer in Sekunden" />
                <TextBlock Text="s" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ───────── Systemmonitor ───────── -->
    <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
        <c:PageLayout>
            <c:PageLayout.HeaderContent>
                <Button Command="{Binding ExportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Export}" Width="14" Height="14" Margin="0,0,8,0" />
                        <TextBlock Text="Messwerte exportieren" />
                    </StackPanel>
                </Button>
            </c:PageLayout.HeaderContent>
            <StackPanel>
                <TextBlock Text="{Binding SamplingInfo}" Style="{StaticResource Text.Caption}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False" Margin="0,0,-12,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="Gespeicherte Historie" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding Metrics}" SelectedItem="{Binding SelectedMetric}" DisplayMemberPath="Label" Width="260" Margin="0,0,10,0" AutomationProperties.Name="Messgröße" />
                            <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Label" Width="190" Margin="0,0,10,0" AutomationProperties.Name="Zeitraum" />
                            <Button Command="{Binding LoadHistoryCommand}" ToolTip="Neu laden" Style="{StaticResource Button.Icon}" AutomationProperties.Name="Historie neu laden">
                                <c:Icon Data="{StaticResource Icon.Refresh}" Width="15" Height="15" />
                            </Button>
                        </StackPanel>
                        <c:TimeChart Points="{Binding HistoryPoints}" Unit="{Binding HistoryUnit}" Height="240" Margin="0,14,0,0" Stroke="{DynamicResource Brush.Accent}"
                                     GridBrush="{DynamicResource Brush.ChartGrid}" LabelBrush="{DynamicResource Brush.TextTertiary}" />
                        <TextBlock Text="{Binding HistorySummary}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Standardregeln wiederherstellen" Style="{StaticResource Button.Link}" Command="{Binding ResetRulesCommand}" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="Warnregeln" Style="{StaticResource Text.Section}" />
                </DockPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Eine Warnung wird erst gemeldet, wenn die Schwelle für die angegebene Dauer verletzt ist; danach gilt eine Abklingzeit, damit schwankende Werte keine Meldungsflut auslösen." Style="{StaticResource Text.Secondary}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding AlertRules}" Focusable="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>
</ResourceDictionary>
