<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:NexusOptimizer.App.Controls"
                    xmlns:vm="clr-namespace:NexusOptimizer.App.ViewModels">

    <!-- ───────── Profile ───────── -->
    <DataTemplate DataType="{x:Type vm:ProfileRow}">
        <Border x:Name="Root" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" Margin="0,0,10,4" />
                        <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.GreenSoft}" Margin="0,0,6,4" Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                            <TextBlock Text="Aktiv" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Green}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Visibility="{Binding IsBuiltIn, Converter={StaticResource Vis}}">
                            <TextBlock Text="Eingebaut" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"><Run Text="{Binding Goal, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Count, Mode=OneWay}" /></TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="Klonen" Margin="0,0,6,0" Style="{StaticResource Button.Subtle}"
                            Command="{Binding DataContext.CloneCommand, RelativeSource={RelativeSource AncestorType=c:PageLayout}}" CommandParameter="{Binding}" />
                    <Button Content="Exportieren" Margin="0,0,6,0" Style="{StaticResource Button.Subtle}"
                            Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=c:PageLayout}}" CommandParameter="{Binding}" />
                    <Button Content="Löschen" Margin="0,0,6,0" Style="{StaticResource Button.Subtle}" Visibility="{Binding IsCustom, Converter={StaticResource Vis}}"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=c:PageLayout}}" CommandParameter="{Binding}" />
                    <Button Content="Aktivieren …" Style="{StaticResource Button.Accent}"
                            Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=c:PageLayout}}" CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
        <c:PageLayout>
            <c:PageLayout.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Importieren …" Command="{Binding ImportCommand}" Margin="0,0,8,0" />
                    <Button Content="Neues Profil …" Command="{Binding CreateFromActiveCommand}" Margin="0,0,8,0" />
                    <Button Content="Aktives Profil zurücksetzen" Command="{Binding ResetCommand}" IsEnabled="{Binding HasActive}" />
                </StackPanel>
            </c:PageLayout.HeaderContent>
            <StackPanel>
                <Border Style="{StaticResource Card.Note}" Margin="0,0,0,12">
                    <TextBlock Text="{Binding ActiveText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                </Border>
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" />

                <TextBlock Text="Profile vergleichen" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" AutomationProperties.Name="Erstes Profil" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding CompareWith}" DisplayMemberPath="Name" AutomationProperties.Name="Zweites Profil" />
                        </Grid>
                        <TextBlock Text="{Binding CompareText}" Style="{StaticResource Text.Secondary}" Margin="0,10,0,6" Visibility="{Binding CompareText, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding Differences}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding Left, TargetNullValue='—'}" Style="{StaticResource Text.Secondary}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Right, TargetNullValue='—'}" Style="{StaticResource Text.Secondary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- ───────── Automatisierung ───────── -->
    <DataTemplate DataType="{x:Type vm:RuleRow}">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" VerticalAlignment="Top" Margin="0,2,14,0" AutomationProperties.Name="Regel aktiv"
                              Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=c:PageLayout}}" CommandParameter="{Binding}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding Problems}" Focusable="False" Visibility="{Binding HasProblems, Converter={StaticResource Vis}}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Red}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Button Grid.Column="2" Content="Löschen" Style="{StaticResource Button.Subtle}" VerticalAlignment="Top" Margin="12,0,0,0"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=c:PageLayout}}" CommandParameter="{Binding}" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:RunRow}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Time}" Style="{StaticResource Text.Caption}" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AutomationViewModel}">
        <c:PageLayout>
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding Enabled}" Content="Automatisierung insgesamt aktiv" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Unbeaufsichtigt werden nur risikoarme, umkehrbare und für Automatik zugelassene Aktionen ausgeführt. Experimentelle Änderungen laufen nie automatisch. Jede Ausführung steht im Protokoll und im Verlauf." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card.Warn}" Margin="0,0,0,12" Visibility="{Binding Conflicts.Count, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="Konflikte zwischen Regeln" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                        <ItemsControl ItemsSource="{Binding Conflicts}" Focusable="False" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" Margin="0,2" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="Regeln" Style="{StaticResource Text.Section}" Margin="0,4,0,10" />
                <TextBlock Text="Noch keine Regeln angelegt." Style="{StaticResource Text.Secondary}" Margin="0,0,0,10" Visibility="{Binding Rules.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                <ItemsControl ItemsSource="{Binding Rules}" Focusable="False" />

                <TextBlock Text="Neue Regel" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="Name der Regel" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Wenn" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding Triggers}" SelectedItem="{Binding SelectedTrigger}" DisplayMemberPath="Label" AutomationProperties.Name="Auslöser" />
                                <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" Tag="Programmname, z. B. game.exe" MaxLength="100" Margin="0,8,0,0" Visibility="{Binding NeedsProcess, Converter={StaticResource Vis}}" AutomationProperties.Name="Programmname" />
                                <TextBox Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" Tag="Schwelle (Prozent bzw. °C)" MaxLength="5" Margin="0,8,0,0" Visibility="{Binding NeedsThreshold, Converter={StaticResource Vis}}" AutomationProperties.Name="Schwelle" />
                                <TextBox Text="{Binding TimeOfDay, UpdateSourceTrigger=PropertyChanged}" Tag="Uhrzeit HH:mm" MaxLength="5" Margin="0,8,0,0" Visibility="{Binding NeedsTime, Converter={StaticResource Vis}}" AutomationProperties.Name="Uhrzeit" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Dann" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding ActionTypes}" SelectedItem="{Binding SelectedActionType}" DisplayMemberPath="Label" AutomationProperties.Name="Aktion" />
                                <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Label" Margin="0,8,0,0" Visibility="{Binding NeedsProfile, Converter={StaticResource Vis}}" AutomationProperties.Name="Profil" />
                                <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" Tag="Text der Benachrichtigung" MaxLength="200" Margin="0,8,0,0" Visibility="{Binding NeedsMessage, Converter={StaticResource Vis}}" AutomationProperties.Name="Nachricht" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding FormError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Red}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding FormError, Converter={StaticResource Vis}}" />
                        <Button Content="Regel hinzufügen" Command="{Binding AddRuleCommand}" Style="{StaticResource Button.Accent}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Protokoll" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Noch keine Ausführungen." Style="{StaticResource Text.Secondary}" Visibility="{Binding History.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding History}" Focusable="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- ───────── Verlauf ───────── -->
    <DataTemplate DataType="{x:Type vm:TransactionRowViewModel}">
        <Border x:Name="Root" Style="{StaticResource Card}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanUndo}" VerticalAlignment="Top" Margin="0,2,10,0" ToolTip="Für „Ausgewählte wiederherstellen“ markieren" AutomationProperties.Name="Eintrag auswählen" />
                <StackPanel Grid.Column="1">
                    <WrapPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" Margin="0,0,10,4" />
                        <ContentControl Content="{Binding Risk}" ContentTemplate="{StaticResource RiskBadge}" Margin="0,0,6,4" Focusable="False" />
                        <Border x:Name="StatusBadge" Style="{StaticResource Badge}" Margin="0,0,6,4">
                            <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding Time, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Source, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{Binding Change}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Actual}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Visibility="{Binding Actual, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding Verification}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Visibility="{Binding Verification, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Red}" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource Vis}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <Button Content="Rückgängig" Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=c:PageLayout}}" CommandParameter="{Binding}" IsEnabled="{Binding CanUndo}" />
                    <Button Content="Ganzen Lauf zurück" Style="{StaticResource Button.Link}" Margin="0,6,0,0" HorizontalAlignment="Right"
                            Command="{Binding DataContext.UndoBatchCommand, RelativeSource={RelativeSource AncestorType=c:PageLayout}}" CommandParameter="{Binding}" IsEnabled="{Binding CanUndo}" />
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource Brush.RedSoft}" />
                <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Brush.Red}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanUndo}" Value="True">
                <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Brush.Green}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
        <c:PageLayout>
            <c:PageLayout.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Exportieren" Command="{Binding ExportCommand}" Margin="0,0,8,0" />
                    <Button Content="Ausgewählte wiederherstellen" Command="{Binding UndoSelectedCommand}" Margin="0,0,8,0" />
                    <Button Command="{Binding UndoLastCommand}" Style="{StaticResource Button.Accent}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Undo}" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="Letzte Änderung rückgängig machen" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageLayout.HeaderContent>
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <CheckBox DockPanel.Dock="Right" Content="Nur Probleme" IsChecked="{Binding OnlyProblems}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    <CheckBox DockPanel.Dock="Right" Content="Nur aktive, umkehrbare" IsChecked="{Binding OnlyActive}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Tag="Verlauf durchsuchen" AutomationProperties.Name="Verlauf durchsuchen" />
                </DockPanel>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" />
                <Border Style="{StaticResource Card}" Visibility="{Binding Rows.Count, Converter={StaticResource Vis}, ConverterParameter=invert}">
                    <TextBlock Text="Keine Einträge. Sobald Sie etwas ändern, erscheint es hier." Style="{StaticResource Text.Secondary}" />
                </Border>
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- ───────── Sicherung ───────── -->
    <DataTemplate DataType="{x:Type vm:BackupViewModel}">
        <c:PageLayout>
            <c:PageLayout.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Ausgewählte wiederherstellen" Command="{Binding RestoreSelectedCommand}" Margin="0,0,8,0" />
                    <Button Content="Alle wiederherstellen" Command="{Binding RestoreAllCommand}" />
                </StackPanel>
            </c:PageLayout.HeaderContent>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Schnellzugriff" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Text="{Binding ActiveProfile}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,10" />
                            <WrapPanel>
                                <Button Command="{Binding UndoLastCommand}" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Data="{StaticResource Icon.Undo}" Width="14" Height="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Letzte Änderung rückgängig machen" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Profil zurücksetzen" Command="{Binding ResetProfileCommand}" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Windows-Wiederherstellungspunkt" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Text="Zusätzliche Absicherung durch Windows selbst (Systemdateien und Registrierung). Windows legt höchstens einen Punkt je 24 Stunden an." Style="{StaticResource Text.Secondary}" Margin="0,4,0,10" TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button Content="Jetzt erstellen …" Command="{Binding CreateRestorePointCommand}" Margin="0,0,8,8" />
                                <Button Content="Windows-Wiederherstellung öffnen" Command="{Binding OpenWindowsRecoveryCommand}" Style="{StaticResource Button.Subtle}" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Wiederherstellbare Änderungen" Style="{StaticResource Text.Section}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Restorable}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,10,0" AutomationProperties.Name="Änderung auswählen" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" />
                                        <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding Time, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Source, Mode=OneWay}" /></TextBlock>
                                        <TextBlock Text="{Binding Change}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Speicherort der Sicherungen" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Die Ausgangszustände liegen im lokalen Transaktionsjournal und bleiben nach einem Neustart der Anwendung erhalten." Style="{StaticResource Text.Secondary}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Storage}" Focusable="False" />
                        <Button Content="Ordner öffnen" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- ───────── Chat ───────── -->
    <DataTemplate DataType="{x:Type vm:ProposalViewModel}">
        <Border Style="{StaticResource Card.Inset}" Margin="0,8,0,0" Background="{DynamicResource Brush.AccentSoft}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding ButtonText}" Command="{Binding RunCommand}" IsEnabled="{Binding IsUsed, Converter={StaticResource Not}}" Margin="12,0,0,0" VerticalAlignment="Top" Style="{StaticResource Button.Accent}" />
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding Description, Converter={StaticResource Vis}}" />
                    <TextBlock Text="Vorschlag – noch nicht ausgeführt. Die Ausführung erfordert Vorschau und Ihre Bestätigung." Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Visibility="{Binding IsUsed, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    <TextBlock Text="{Binding State}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding State, Converter={StaticResource Vis}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
        <Grid Margin="0,0,0,12">
            <Border x:Name="Bubble" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="14,10" HorizontalAlignment="Left" MaxWidth="760">
                <StackPanel>
                    <TextBlock x:Name="Kind" Text="{Binding KindTextCurrent}" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                    <ItemsControl ItemsSource="{Binding Proposals}" Focusable="False" />
                </StackPanel>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsUser}" Value="True">
                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                <Setter TargetName="Kind" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSystem}" Value="True">
                <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Brush.Input}" />
                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Stretch" />
                <Setter TargetName="Bubble" Property="MaxWidth" Value="1200" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ChatViewModel}">
        <c:PageLayout Scrollable="False">
            <c:PageLayout.HeaderContent>
                <Button Content="Verlauf löschen" Command="{Binding ClearHistoryCommand}" />
            </c:PageLayout.HeaderContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card.Note}" Margin="0,0,0,10">
                    <TextBlock Text="{Binding ProviderText}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" c:Attach.AutoScroll="True" Padding="0,0,8,0">
                    <ItemsControl ItemsSource="{Binding Messages}" Focusable="False" />
                </ScrollViewer>
                <ItemsControl Grid.Row="2" ItemsSource="{Binding Suggestions}" Margin="0,8,0,8" Focusable="False" Style="{StaticResource Items.Wrap}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Style="{StaticResource Button.Subtle}" Margin="0,0,6,6" FontSize="12"
                                    Command="{Binding DataContext.AskSuggestionCommand, RelativeSource={RelativeSource AncestorType=c:PageLayout}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Grid.Row="3">
                    <Button DockPanel.Dock="Right" Content="Senden" Command="{Binding SendCommand}" Style="{StaticResource Button.Accent}" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Abbrechen" Command="{Binding CancelCommand}" Margin="8,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" />
                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Tag="Frage stellen – Eingabetaste sendet" MaxLength="2000" AcceptsReturn="False" c:Attach.EnterCommand="{Binding SendCommand}" AutomationProperties.Name="Nachricht an den Assistenten" />
                </DockPanel>
            </Grid>
        </c:PageLayout>
    </DataTemplate>

    <!-- ───────── Einstellungen ───────── -->
    <Style x:Key="Card.Setting" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="18" />
    </Style>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <c:PageLayout>
            <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                <Border Style="{StaticResource Card.Setting}">
                    <StackPanel>
                        <TextBlock Text="Darstellung und Start" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Design" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding ThemeChoice}" DisplayMemberPath="Label" AutomationProperties.Name="Design" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Akzentfarbe" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent}" DisplayMemberPath="Label" AutomationProperties.Name="Akzentfarbe" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Label}" Margin="0,12,0,5"><Run Text="Schriftgröße: " /><Run Text="{Binding FontScale, StringFormat='{}{0:P0}', Mode=OneWay}" /></TextBlock>
                        <Slider Minimum="0.85" Maximum="1.5" Value="{Binding FontScale}" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="Schriftgröße" />
                        <WrapPanel Margin="0,12,0,0">
                            <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding Animations}" Content="Animationen" Margin="0,0,28,8" />
                            <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding Notifications}" Content="Benachrichtigungen" Margin="0,0,28,8" />
                            <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding StartWithWindows}" Content="Mit Windows starten" Margin="0,0,28,8" />
                            <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding StartMinimized}" Content="Minimiert starten" Margin="0,0,28,8" />
                        </WrapPanel>
                        <TextBlock Text="Die Anwendung startet beim Anmelden nur dann, wenn Sie „Mit Windows starten“ ausdrücklich einschalten; es wird ein Eintrag im Autostart Ihres Benutzerkontos angelegt. Die Sprache ist Deutsch." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card.Setting}">
                    <StackPanel>
                        <TextBlock Text="Sicherheit und Freigaben" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="Legt fest, was mit Ihrer Bestätigung und was unbeaufsichtigt (Automatik, Regeln, Gaming-Modus) geändert werden darf." Style="{StaticResource Text.Secondary}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Höchstes Risiko mit Bestätigung" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding Risks}" SelectedItem="{Binding MaxInteractive}" DisplayMemberPath="Label" AutomationProperties.Name="Höchstes Risiko mit Bestätigung" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Höchstes Risiko unbeaufsichtigt" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding UnattendedRisks}" SelectedItem="{Binding MaxUnattended}" DisplayMemberPath="Label" AutomationProperties.Name="Höchstes Risiko unbeaufsichtigt" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Unbeaufsichtigt ist höchstens „Niedrig“ möglich – unabhängig von dieser Auswahl. Experimentelle Änderungen laufen nie ohne Ihre Einzelbestätigung." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Primäres Optimierungsziel" Style="{StaticResource Text.Label}" />
                            <ComboBox ItemsSource="{Binding Goals}" SelectedItem="{Binding Goal}" DisplayMemberPath="Label" Width="320" HorizontalAlignment="Left" AutomationProperties.Name="Optimierungsziel" />
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0">
                            <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding ConfirmEveryChange}" Content="Jede Änderung mit Vorschau bestätigen (empfohlen)" Margin="0,0,0,8" />
                            <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding RestorePointBeforeBatch}" Content="Vor Optimierungsläufen einen Windows-Wiederherstellungspunkt vorschlagen" Margin="0,0,0,8" />
                            <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding RestoreProfileOnExit}" Content="Aktives Profil beim Beenden der Anwendung zurücknehmen" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card.Setting}">
                    <StackPanel>
                        <TextBlock Text="Überwachung" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Abtastintervall in Sekunden (0,5–30)" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Abtastintervall" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Aufbewahrung der Historie in Tagen (1–90)" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding Retention, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" AutomationProperties.Name="Aufbewahrung in Tagen" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,12,0,0">
                            <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding PersistHistory}" Content="Historie lokal speichern" Margin="0,0,28,8" />
                            <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding NvidiaSensors}" Content="NVIDIA-Sensoren auslesen" Margin="0,0,28,8" />
                            <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding LatencyProbe}" Content="Netzwerklatenz messen" Margin="0,0,28,8" />
                        </WrapPanel>
                        <TextBox Text="{Binding LatencyEndpoints, UpdateSourceTrigger=PropertyChanged}" Tag="Gegenstellen für die Latenzmessung (höchstens 5, durch Komma getrennt) – es wird nichts ohne Ihre Eingabe angepingt" Margin="0,4,0,0" MaxLength="200" AutomationProperties.Name="Gegenstellen der Latenzmessung" />
                        <Button Content="Überwachung speichern" Command="{Binding ApplyMonitoringCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card.Setting}">
                    <StackPanel>
                        <TextBlock Text="KI und Datenschutz" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Standard ist das lokale Regelwerk ohne Netzwerkzugriff. Ein Sprachmodell wird nur für Erklärungen im Chat genutzt; ausgeführt wird nie Modelltext." />
                        <TextBlock Text="Anbieter" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding AiProviders}" SelectedItem="{Binding AiProvider}" DisplayMemberPath="Label" AutomationProperties.Name="KI-Anbieter" />

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsOllama, Converter={StaticResource Vis}}">
                            <TextBlock Text="Ollama-Adresse" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding OllamaEndpoint, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Ollama-Adresse" />
                            <TextBlock Text="Modell" Style="{StaticResource Text.Label}" Margin="0,8,0,5" />
                            <TextBox Text="{Binding OllamaModel, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Ollama-Modell" />
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsAnthropic, Converter={StaticResource Vis}}">
                            <TextBlock Text="Claude-Modell" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding AnthropicModel, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Claude-Modell" />
                            <TextBlock Text="API-Schlüssel (wird verschlüsselt im Benutzerprofil abgelegt, nie angezeigt oder protokolliert)" Style="{StaticResource Text.Label}" Margin="0,8,0,5" />
                            <PasswordBox c:PasswordBinder.Password="{Binding AnthropicKey, Mode=TwoWay}" MaxLength="300" AutomationProperties.Name="Claude-API-Schlüssel" />
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsOpenAi, Converter={StaticResource Vis}}">
                            <TextBlock Text="Adresse (https://… oder lokal)" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding OpenAiEndpoint, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Dienstadresse" />
                            <TextBlock Text="Modell" Style="{StaticResource Text.Label}" Margin="0,8,0,5" />
                            <TextBox Text="{Binding OpenAiModel, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Modell" />
                            <TextBlock Text="API-Schlüssel" Style="{StaticResource Text.Label}" Margin="0,8,0,5" />
                            <PasswordBox c:PasswordBinder.Password="{Binding OpenAiKey, Mode=TwoWay}" MaxLength="300" AutomationProperties.Name="API-Schlüssel" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasLanguageModel, Converter={StaticResource Vis}}">
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Einstellungen speichern" Command="{Binding ApplyAiEndpointsCommand}" Margin="0,0,8,8" />
                                <Button Content="Schlüssel speichern" Command="{Binding SaveKeysCommand}" Margin="0,0,8,8" />
                                <Button Content="Schlüssel entfernen" Command="{Binding RemoveKeysCommand}" Style="{StaticResource Button.Subtle}" Margin="0,0,8,8" />
                                <Button Content="Verbindung testen" Command="{Binding TestConnectionCommand}" IsEnabled="{Binding IsTesting, Converter={StaticResource Not}}" Margin="0,0,8,8" />
                            </WrapPanel>
                            <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding AiTestResult}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding AiTestResult, Converter={StaticResource Vis}}" />

                            <TextBlock Text="Datenschutz" Style="{StaticResource Text.CardTitle}" Margin="0,18,0,8" />
                            <TextBlock Text="Detailgrad des Systemkontexts" Style="{StaticResource Text.Label}" />
                            <ComboBox ItemsSource="{Binding PrivacyModes}" SelectedItem="{Binding PrivacyChoice}" DisplayMemberPath="Label" AutomationProperties.Name="Datenschutzmodus" />
                            <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding CloudConsent}" Content="Ich stimme der Übermittlung des Kontexts an einen nicht lokalen Dienst zu" Margin="0,12,0,0" />
                            <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding SaveChat}" Content="Chatverlauf lokal speichern" Margin="0,8,0,0" />
                            <Button Content="Gesendeten Kontext anzeigen" Command="{Binding PreviewContextCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                            <Border Style="{StaticResource Card.Inset}" Margin="0,8,0,0" Visibility="{Binding ContextPreview, Converter={StaticResource Vis}}">
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding ContextPreview}" Style="{StaticResource Text.Mono}" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card.Setting}">
                    <StackPanel>
                        <TextBlock Text="Erweitert und Daten" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,12" />
                        <TextBlock Text="Protokollstufe" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" DisplayMemberPath="Label" Width="240" HorizontalAlignment="Left" AutomationProperties.Name="Protokollstufe" />
                        <TextBlock Text="PresentMon für Frametime-Messung (optional, wird nicht mitgeliefert)" Style="{StaticResource Text.Label}" Margin="0,12,0,5" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Speichern" Command="{Binding ApplyPresentMonCommand}" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="Durchsuchen …" Command="{Binding BrowsePresentMonCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding PresentMonPath, UpdateSourceTrigger=PropertyChanged}" MaxLength="260" AutomationProperties.Name="Pfad zu PresentMon" />
                        </DockPanel>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="Protokollordner öffnen" Command="{Binding OpenLogsCommand}" Margin="0,0,8,8" />
                            <Button Content="Datenordner öffnen" Command="{Binding OpenDataCommand}" Margin="0,0,8,8" />
                            <Button Content="Einstellungen zurücksetzen" Command="{Binding ResetSettingsCommand}" Margin="0,0,8,8" />
                            <Button Content="Alle Anwendungsdaten löschen …" Command="{Binding DeleteDataCommand}" Style="{StaticResource Button.Danger}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0">
                            <Run Text="Protokolle: " /><Run Text="{Binding LogDirectory, Mode=OneWay}" /><LineBreak /><Run Text="Daten: " /><Run Text="{Binding DataDirectory, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Validation}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding Validation, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card.Setting}">
                    <StackPanel>
                        <TextBlock Text="Über NEXUS Optimizer AI" Style="{StaticResource Text.CardTitle}" />
                        <TextBlock Text="{Binding Version, StringFormat='Version {0} (Entwicklungsstand)'}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Automatische Updates sind nicht eingerichtet; es findet keine Netzwerkabfrage nach neuen Versionen statt. Die Anwendung ist nicht code-signiert, solange kein Signaturzertifikat verwendet wurde – Windows SmartScreen kann deshalb warnen." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>
</ResourceDictionary>
