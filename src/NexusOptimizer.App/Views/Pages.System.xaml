<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:NexusOptimizer.App.Controls"
                    xmlns:vm="clr-namespace:NexusOptimizer.App.ViewModels">

    <!-- Rechtsbündige Zahlenspalte -->
    <Style x:Key="Cell.Right" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="Cell.Trim" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ───────── Autostart ───────── -->
    <DataTemplate DataType="{x:Type vm:StartupItemViewModel}">
        <Border x:Name="Root" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" Margin="0,0,10,4" />
                        <Border x:Name="StateBadge" Style="{StaticResource Badge}" Background="{DynamicResource Brush.GreenSoft}" Margin="0,0,6,4">
                            <TextBlock x:Name="StateText" Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Green}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Visibility="{Binding RequiresAdmin, Converter={StaticResource Vis}}" ToolTip="Der Eintrag gilt für alle Benutzer – Änderungen erfordern Administratorrechte (UAC).">
                            <TextBlock Text="Alle Benutzer" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.AmberSoft}" Margin="0,0,6,4" Visibility="{Binding IsMissing, Converter={StaticResource Vis}}">
                            <TextBlock Text="Datei fehlt" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Amber}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Text.Secondary}">
                        <Run Text="{Binding Publisher, Mode=OneWay}" /><Run Text="  ·  " /><Run x:Name="Signature" Text="{Binding SignatureText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SourceText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Command}" Style="{StaticResource Text.Mono}" Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="Speicherort" Command="{Binding ShowFileCommand}" Style="{StaticResource Button.Subtle}" Margin="0,0,8,0" />
                    <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" MinWidth="110" />
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource Brush.Track}" />
                <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SignatureWarning}" Value="True">
                <Setter TargetName="Signature" Property="Foreground" Value="{DynamicResource Brush.Red}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:StartupViewModel}">
        <c:PageLayout>
            <c:PageLayout.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding OpenWindowsStartupSettingsCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Windows-Autostart-Apps" />
                            <c:Icon Data="{StaticResource Icon.External}" Width="13" Height="13" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Content="Neu einlesen" Command="{Binding LoadCommand}" />
                </StackPanel>
            </c:PageLayout.HeaderContent>
            <StackPanel>
                <Border Style="{StaticResource Card.Note}" Margin="0,0,0,12">
                    <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"
                               Text="Wie stark ein einzelner Eintrag den Systemstart verzögert, wird hier nicht behauptet: Diese Anwendung misst das nicht. Die Angabe „Startauswirkung“ finden Sie im Windows-Task-Manager. Aufgaben der Aufgabenplanung und Dienste erscheinen nicht in dieser Liste." />
                </Border>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Tag="Einträge filtern (Name, Herausgeber, Befehl)" MaxWidth="460" HorizontalAlignment="Left" Width="460" AutomationProperties.Name="Autostart filtern" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False" />
                <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                    <TextBlock Text="Keine passenden Autostarteinträge." Style="{StaticResource Text.Secondary}" />
                </Border>
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- ───────── Prozesse ───────── -->
    <DataTemplate DataType="{x:Type vm:ProcessesViewModel}">
        <c:PageLayout Scrollable="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding IsPaused}" Content="Anhalten" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Label" Width="200" Margin="10,0,0,0" AutomationProperties.Name="Sortierung" />
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Tag="Prozesse filtern (Name oder PID)" AutomationProperties.Name="Prozesse filtern" />
                </DockPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0">
                    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" CanUserSortColumns="False" AutomationProperties.Name="Prozessliste">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource Cell.Trim}" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" ElementStyle="{StaticResource Cell.Right}" />
                            <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="80" ElementStyle="{StaticResource Cell.Right}" />
                            <DataGridTextColumn Header="Arbeitsspeicher" Binding="{Binding MemoryText}" Width="120" ElementStyle="{StaticResource Cell.Right}" />
                            <DataGridTextColumn Header="Privat" Binding="{Binding PrivateText}" Width="100" ElementStyle="{StaticResource Cell.Right}" />
                            <DataGridTextColumn Header="Datenträger" Binding="{Binding DiskText}" Width="110" ElementStyle="{StaticResource Cell.Right}" />
                            <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="80" ElementStyle="{StaticResource Cell.Right}" />
                            <DataGridTextColumn Header="Priorität" Binding="{Binding PriorityText}" Width="150" />
                            <DataGridTextColumn Header="Herausgeber / Beschreibung" Binding="{Binding Publisher}" Width="2*" ElementStyle="{StaticResource Cell.Trim}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0">
                    <Grid>
                        <TextBlock Text="Wählen Sie einen Prozess aus, um Details zu sehen, die Priorität zu ändern oder ihn zu beenden." Style="{StaticResource Text.Secondary}"
                                   Visibility="{Binding HasSelection, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        <Grid Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.Detail}" Style="{StaticResource Text.CardTitle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Selected.Path, TargetNullValue='Pfad nicht lesbar (Zugriff verweigert oder Systemprozess)'}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Dieser Prozess gehört zu Windows oder zur Sicherheitssoftware und ist geschützt." Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Amber}" Margin="0,3,0,0"
                                           Visibility="{Binding CanChangeSelected, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Content="Speicherort" Command="{Binding ShowFileCommand}" Style="{StaticResource Button.Subtle}" Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}" DisplayMemberPath="Label" Width="190" Margin="0,0,8,0" IsEnabled="{Binding CanChangeSelected}" AutomationProperties.Name="Neue Priorität" />
                                <Button Content="Priorität setzen" Command="{Binding SetPriorityCommand}" IsEnabled="{Binding CanChangeSelected}" Margin="0,0,8,0" />
                                <Button Content="Prozess beenden" Command="{Binding TerminateCommand}" IsEnabled="{Binding CanChangeSelected}" Style="{StaticResource Button.Danger}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </c:PageLayout>
    </DataTemplate>

    <!-- ───────── Dienste ───────── -->
    <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
        <c:PageLayout Scrollable="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Neu einlesen" Command="{Binding LoadCommand}" Margin="16,0,0,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <CheckBox DockPanel.Dock="Right" Content="Nur laufende" IsChecked="{Binding OnlyRunning}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <CheckBox DockPanel.Dock="Right" Content="Nur mit Einschätzung" IsChecked="{Binding OnlyWithAdvice}" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="Zeigt nur Dienste, zu denen eine geprüfte Erläuterung hinterlegt ist." />
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Tag="Dienste filtern" AutomationProperties.Name="Dienste filtern" />
                </DockPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,0,12,0">
                    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" CanUserSortColumns="True" AutomationProperties.Name="Dienstliste">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Anzeigename" Binding="{Binding DisplayName}" Width="3*" ElementStyle="{StaticResource Cell.Trim}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="130" />
                            <DataGridTextColumn Header="Starttyp" Binding="{Binding StartModeText}" Width="170" />
                            <DataGridTextColumn Header="Hinweis" Binding="{Binding Marker}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                    <Grid>
                        <TextBlock Text="Wählen Sie einen Dienst aus, um Beschreibung, Abhängigkeiten und Starttyp zu sehen." Style="{StaticResource Text.Secondary}"
                                   Visibility="{Binding HasSelection, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0" Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.DisplayName}" Style="{StaticResource Text.CardTitle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource Text.Mono}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Selected.Description}" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" />

                                <Border Style="{StaticResource Card.Warn}" Margin="0,12,0,0" Visibility="{Binding Selected.IsProtected, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding Selected.ProtectionReason}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                                </Border>

                                <Border Style="{StaticResource Card.Note}" Margin="0,12,0,0" Visibility="{Binding Selected.HasAdvice, Converter={StaticResource Vis}}">
                                    <StackPanel>
                                        <TextBlock Text="Einschätzung" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Text="{Binding Selected.Advice.Purpose}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" Margin="0,4,0,0" />
                                        <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" Margin="0,6,0,0"><Run FontWeight="SemiBold" Text="Änderbar, wenn: " /><Run Text="{Binding Selected.Advice.WhenSafeToChange, Mode=OneWay}" /></TextBlock>
                                        <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" Margin="0,6,0,0"><Run FontWeight="SemiBold" Text="Folgen: " /><Run Text="{Binding Selected.Advice.Consequences, Mode=OneWay}" /></TextBlock>
                                        <ContentControl Content="{Binding Selected.Advice.Risk}" ContentTemplate="{StaticResource RiskBadge}" HorizontalAlignment="Left" Margin="0,8,0,0" Focusable="False" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Status" Style="{StaticResource Text.Label}" Margin="0,14,0,2" />
                                <TextBlock Style="{StaticResource Text.Body}"><Run Text="{Binding Selected.State, Mode=OneWay}" /><Run Text=" · Starttyp: " /><Run Text="{Binding Selected.StartModeText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Text="Hängt ab von" Style="{StaticResource Text.Label}" Margin="0,10,0,2" />
                                <TextBlock Text="{Binding Selected.DependsOnText}" Style="{StaticResource Text.Body}" />
                                <TextBlock Text="Wird benötigt von" Style="{StaticResource Text.Label}" Margin="0,10,0,2" />
                                <TextBlock Text="{Binding Selected.DependentsText}" Style="{StaticResource Text.Body}" />
                                <TextBlock Text="Konto" Style="{StaticResource Text.Label}" Margin="0,10,0,2" />
                                <TextBlock Text="{Binding Selected.AccountText}" Style="{StaticResource Text.Body}" />
                                <TextBlock Text="Programmpfad" Style="{StaticResource Text.Label}" Margin="0,10,0,2" />
                                <TextBlock Text="{Binding Selected.PathText}" Style="{StaticResource Text.Mono}" />

                                <TextBlock Text="Neuer Starttyp" Style="{StaticResource Text.Label}" Margin="0,16,0,5" />
                                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Label" IsEnabled="{Binding CanChangeSelected}" AutomationProperties.Name="Neuer Starttyp" />
                                <Button Content="Starttyp ändern …" Command="{Binding ApplyModeCommand}" IsEnabled="{Binding CanChangeSelected}" Style="{StaticResource Button.Accent}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        ToolTip="Zeigt zuerst eine Vorschau. Erfordert Administratorrechte (UAC)." />
                                <TextBlock Text="Der Dienst wird nicht gestartet oder beendet – geändert wird nur, wie er künftig startet. Der bisherige Starttyp wird gesichert." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </c:PageLayout>
    </DataTemplate>

    <!-- Filterleiste für Tweak-Listen (DataContext = TweakListPageViewModel) -->
    <DataTemplate x:Key="TweakFilterBar">
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Angezeigte offene anwenden …" Command="{Binding ApplyVisibleCommand}" Margin="10,0,0,0" ToolTip="Öffnet eine Vorschau aller angezeigten, noch nicht angewendeten Einstellungen." />
                <Button DockPanel.Dock="Right" Content="Filter zurücksetzen" Command="{Binding ClearFilterCommand}" Style="{StaticResource Button.Subtle}" Margin="10,0,0,0" />
                <CheckBox DockPanel.Dock="Right" Content="Nur offene" IsChecked="{Binding OnlyOpen}" Margin="14,0,0,0" VerticalAlignment="Center" ToolTip="Blendet Einstellungen aus, die bereits im Zielzustand oder nicht verfügbar sind." />
                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label" Width="230" Margin="10,0,0,0" AutomationProperties.Name="Kategorie" />
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Tag="Einstellungen filtern" AutomationProperties.Name="Einstellungen filtern" />
            </DockPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" Margin="0,0,0,10" />
        </StackPanel>
    </DataTemplate>

    <!-- ───────── Registry-Tweaks ───────── -->
    <DataTemplate DataType="{x:Type vm:RegistryViewModel}">
        <c:PageLayout>
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TweakFilterBar}" Focusable="False" />
                <ItemsControl ItemsSource="{Binding Tweaks}" Focusable="False" />
                <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                    <TextBlock Text="Keine Einstellung entspricht dem Filter." Style="{StaticResource Text.Secondary}" />
                </Border>
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- ───────── Datenschutz ───────── -->
    <DataTemplate DataType="{x:Type vm:PrivacyViewModel}">
        <c:PageLayout>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sicherheitsfunktionen (nur Anzeige)" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Text="Diese Werte werden gelesen, aber nie verändert. Virenschutz, Firewall, Benutzerkontensteuerung und SmartScreen lassen sich über diese Anwendung nicht abschalten." Style="{StaticResource Text.Secondary}" Margin="0,6,0,8" />
                            <ItemsControl ItemsSource="{Binding Security}" Focusable="False" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Windows-Einstellungen öffnen" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Text="Berechtigungen einzelner Apps und Diagnosedaten verwalten Sie direkt in Windows." Style="{StaticResource Text.Secondary}" Margin="0,6,0,8" />
                            <ItemsControl ItemsSource="{Binding Links}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="0,3"
                                                Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Value}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" />
                                                <c:Icon Data="{StaticResource Icon.External}" Width="12" Height="12" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Datenschutzeinstellungen" Style="{StaticResource Text.Section}" Margin="0,8,0,10" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TweakFilterBar}" Focusable="False" />
                <ItemsControl ItemsSource="{Binding Tweaks}" Focusable="False" />
                <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                    <TextBlock Text="Keine Einstellung entspricht dem Filter." Style="{StaticResource Text.Secondary}" />
                </Border>
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- Diagnosegruppe -->
    <DataTemplate DataType="{x:Type vm:DiagnosticGroup}">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="6*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource Icon.Shield}" Width="13" Height="13" Margin="0,2,6,0" VerticalAlignment="Top" Foreground="{DynamicResource Brush.Amber}"
                                            Visibility="{Binding IsSecurityRelevant, Converter={StaticResource Vis}}" ToolTip="Sicherheitsrelevant – wird von dieser Anwendung nicht verändert." />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="10,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Explanation}" Style="{StaticResource Text.Secondary}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ───────── Expertenlabor ───────── -->
    <DataTemplate DataType="{x:Type vm:AdvancedViewModel}">
        <c:PageLayout>
            <StackPanel>
                <Border x:Name="LockCard" Style="{StaticResource Card}" BorderBrush="{DynamicResource Brush.Amber}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Freischalten …" Command="{Binding UnlockCommand}" Style="{StaticResource Button.Danger}" VerticalAlignment="Center" Margin="16,0,0,0"
                                Visibility="{Binding IsUnlocked, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        <Button DockPanel.Dock="Right" Content="Wieder sperren" Command="{Binding LockCommand}" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="{Binding IsUnlocked, Converter={StaticResource Vis}}" />
                        <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Flask}" Width="22" Height="22" Foreground="{DynamicResource Brush.Amber}" Margin="0,2,14,0" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Experimentelle Einstellungen" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Text="{Binding UnlockText}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <StackPanel Visibility="{Binding IsUnlocked, Converter={StaticResource Vis}}">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TweakFilterBar}" Focusable="False" />
                    <ItemsControl ItemsSource="{Binding Tweaks}" Focusable="False" />
                </StackPanel>

                <TextBlock Text="Verbreitete Tuning-Tipps im Faktencheck (nur Anzeige)" Style="{StaticResource Text.Section}" />
                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,0,0,10"
                           Text="Viele oft empfohlene „Geheimtipps“ haben auf aktuellen Windows-Versionen keinen messbaren Nutzen oder schwächen die Sicherheit. Diese Werte werden deshalb nur angezeigt und erklärt – ändern lassen sie sich hier nicht." />
                <ItemsControl ItemsSource="{Binding DiagnosticGroups}" Focusable="False" />
                <Border Style="{StaticResource Card}" Visibility="{Binding DiagnosticGroups.Count, Converter={StaticResource Vis}, ConverterParameter=invert}">
                    <TextBlock Text="Die Diagnosewerte sind auf diesem System nicht verfügbar." Style="{StaticResource Text.Secondary}" />
                </Border>

                <TextBlock Text="Geführte manuelle Schritte" Style="{StaticResource Text.Section}" />
                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,0,0,10"
                           Text="Diese Änderungen nimmt die Anwendung bewusst nicht selbst vor (Firmware, Treiber, Hardware). Sie erhalten eine Anleitung und entscheiden selbst." />
                <ItemsControl ItemsSource="{Binding Workflows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <ContentPresenter Content="{Binding}" />
                                <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="2,-4,0,0" Visibility="{Binding HasLink, Converter={StaticResource Vis}}"
                                        Command="{Binding DataContext.OpenWorkflowLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Passende Windows-Einstellung öffnen" />
                                        <c:Icon Data="{StaticResource Icon.External}" Width="12" Height="12" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>
</ResourceDictionary>
