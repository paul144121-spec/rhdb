<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:NexusOptimizer.App.Controls"
                    xmlns:vm="clr-namespace:NexusOptimizer.App.ViewModels">

    <!-- ───────── Bereinigung ───────── -->
    <DataTemplate DataType="{x:Type vm:CleanupCategoryViewModel}">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,10,0" AutomationProperties.Name="{Binding Name}"
                          Command="{Binding DataContext.UpdateTotalCommand, RelativeSource={RelativeSource AncestorType=c:PageLayout}}" />
                <StackPanel Grid.Column="1">
                    <WrapPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" Margin="0,0,10,4" />
                        <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Visibility="{Binding RequiresAdmin, Converter={StaticResource Vis}}">
                            <TextBlock Text="Administrator" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" />
                    <TextBlock Text="{Binding Safeguards}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Visibility="{Binding Safeguards, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding BlockingText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Amber}" Margin="0,2,0,0" Visibility="{Binding BlockingText, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Amber}" Margin="0,2,0,0" Visibility="{Binding Note, Converter={StaticResource Vis}}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="16,2,0,0" VerticalAlignment="Top" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
        <c:PageLayout>
            <c:PageLayout.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Neu prüfen" Command="{Binding ScanCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsScanning, Converter={StaticResource Not}}" />
                    <Button Content="Ausgewählte bereinigen …" Command="{Binding CleanCommand}" Style="{StaticResource Button.Accent}" />
                </StackPanel>
            </c:PageLayout.HeaderContent>
            <StackPanel>
                <Border Style="{StaticResource Card.Warn}" Margin="0,0,0,12">
                    <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"
                               Text="Die Bereinigung löscht Dateien endgültig und lässt sich nicht rückgängig machen. Deshalb sehen Sie vorab pro Kategorie, wie viel betroffen ist, und bestätigen in einer Vorschau. Automatisch läuft sie nie." />
                </Border>
                <TextBlock Text="{Binding TotalText}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Categories}" Focusable="False" />
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- ───────── Reparatur ───────── -->
    <DataTemplate DataType="{x:Type vm:RepairToolViewModel}">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" Margin="0,0,10,4" TextWrapping="Wrap" />
                        <ContentControl Content="{Binding Risk}" ContentTemplate="{StaticResource RiskBadge}" Margin="0,0,6,4" Focusable="False" />
                        <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.GreenSoft}" Margin="0,0,6,4" Visibility="{Binding IsReadOnly, Converter={StaticResource Vis}}">
                            <TextBlock Text="Nur Prüfung" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Green}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="0,0,6,4">
                            <TextBlock Text="Administrator" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Wirkung: " /><Run Text="{Binding ExpectedEffect, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="{Binding SideEffects, Converter={StaticResource Vis}}"><Run FontWeight="SemiBold" Text="Nebenwirkungen: " /><Run Text="{Binding SideEffects, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{Binding Duration}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastRun}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,8,0,0" />
                    <Expander Header="Ausgabe des Werkzeugs" Margin="0,6,0,0" Visibility="{Binding HasOutput, Converter={StaticResource Vis}}">
                        <Border Style="{StaticResource Card.Inset}">
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding LastOutput}" Style="{StaticResource Text.Mono}" />
                            </ScrollViewer>
                        </Border>
                    </Expander>
                </StackPanel>
                <Button Grid.Column="1" Content="Ausführen …" Command="{Binding RunCommand}" VerticalAlignment="Top" Margin="16,0,0,0" MinWidth="120" Style="{StaticResource Button.Accent}" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:RepairViewModel}">
        <c:PageLayout>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Notices}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card.Warn}" Margin="0,0,0,8">
                                <TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0">
                            <Button Content="Wiederherstellungspunkt erstellen …" Command="{Binding CreateRestorePointCommand}" />
                            <Button Content="Windows-Wiederherstellung öffnen" Command="{Binding OpenRecoverySettingsCommand}" Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Vor Reparaturen: Wiederherstellungspunkt" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Text="{Binding RestorePointText}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock Text="Empfohlene Reihenfolge: Schnellprüfung → vollständige Prüfung → SFC → Reparatur nur bei Befund." Style="{StaticResource Text.Section}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Tools}" Focusable="False" />
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- ───────── Diagnose ───────── -->
    <DataTemplate DataType="{x:Type vm:FindingViewModel}">
        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Tag" Style="{StaticResource Badge}" Background="{DynamicResource Brush.BlueSoft}" VerticalAlignment="Top" Width="96" Margin="0,2,14,0">
                    <TextBlock x:Name="TagText" Text="{Binding SeverityText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource Text.CardTitle}" TextWrapping="Wrap"><Run Text="{Binding Area, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Title, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="Zur passenden Seite" Style="{StaticResource Button.Link}" VerticalAlignment="Top" Margin="12,0,0,0" Visibility="{Binding HasPage, Converter={StaticResource Vis}}"
                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=c:PageLayout}}" CommandParameter="{Binding}" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Ok">
                <Setter TargetName="Tag" Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource Brush.Green}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                <Setter TargetName="Tag" Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource Brush.Amber}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                <Setter TargetName="Tag" Property="Background" Value="{DynamicResource Brush.RedSoft}" />
                <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource Brush.Red}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Unavailable">
                <Setter TargetName="Tag" Property="Background" Value="{DynamicResource Brush.Track}" />
                <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
        <c:PageLayout>
            <c:PageLayout.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Bericht speichern" Command="{Binding ExportCommand}" Margin="0,0,8,0" />
                    <Button Content="Diagnose neu starten" Command="{Binding RunCommand}" Style="{StaticResource Button.Accent}" />
                </StackPanel>
            </c:PageLayout.HeaderContent>
            <StackPanel>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Findings}" Focusable="False" />

                <TextBlock Text="Zuverlässigkeit" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}"><TextBlock Text="{Binding Reliability}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" /></Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Abstürze und Hänger (7 Tage)" Style="{StaticResource Text.Section}" />
                        <Border Style="{StaticResource Card}"><ItemsControl ItemsSource="{Binding Crashes}" Focusable="False" /></Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Geräte mit Problemen" Style="{StaticResource Text.Section}" />
                        <Border Style="{StaticResource Card}"><ItemsControl ItemsSource="{Binding Devices}" Focusable="False" /></Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Fehler im Ereignisprotokoll" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding EventsNote}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Events}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Text.Caption}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Source}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" MaxHeight="34" TextWrapping="Wrap" ToolTip="{Binding Message}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- ───────── Benchmark ───────── -->
    <DataTemplate DataType="{x:Type vm:BenchmarkOptionViewModel}">
        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
            <StackPanel>
                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LastResult}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Green}" Margin="26,4,0,0" Visibility="{Binding LastResult, Converter={StaticResource Vis}}" />
                <Expander Header="Methodik und Grenzen" Margin="22,4,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Secondary}"><Run FontWeight="SemiBold" Text="Methodik: " /><Run Text="{Binding Methodology, Mode=OneWay}" /></TextBlock>
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"><Run FontWeight="SemiBold" Text="Grenzen: " /><Run Text="{Binding Limitations, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:BenchmarkViewModel}">
        <c:PageLayout>
            <StackPanel>
                <Border Style="{StaticResource Card.Note}" Margin="0,0,0,12">
                    <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"
                               Text="Es gibt bewusst keinen Gesamt-Score. Jeder Wert ist ein tatsächlich gemessener Median mit Streuung. Ein Unterschied gilt nur dann als Verbesserung oder Verschlechterung, wenn er größer ist als das Messrauschen." />
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Bezeichnung dieser Messung (optional, z. B. „vor Optimierung“)" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="Bezeichnung der Messung" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Läufe je Test" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding Runs, UpdateSourceTrigger=LostFocus}" MaxLength="2" AutomationProperties.Name="Anzahl der Läufe" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                            <Button Content="Abbrechen" Command="{Binding CancelCommand}" Margin="0,0,8,0" Visibility="{Binding IsRunning, Converter={StaticResource Vis}}" />
                            <Button Content="Auswahl messen" Command="{Binding RunCommand}" Style="{StaticResource Button.Accent}" IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsRunning, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,10" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Options}" Focusable="False" />

                <TextBlock Text="Verlauf und Vergleich" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Ausgangsmessung" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding BaselineRow}" AutomationProperties.Name="Ausgangsmessung">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Time, Mode=OneWay}" /> · <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="{Binding Label, Mode=OneWay}" /></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Vergleichsmessung" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding CandidateRow}" AutomationProperties.Name="Vergleichsmessung">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Time, Mode=OneWay}" /> · <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="{Binding Label, Mode=OneWay}" /></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Comparison}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Keine gespeicherten Messungen." Style="{StaticResource Text.Secondary}" Visibility="{Binding History.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Body}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Median}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Spread}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Label}" Style="{StaticResource Text.Secondary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>

    <!-- ───────── Gaming ───────── -->
    <DataTemplate DataType="{x:Type vm:GameRowViewModel}">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Profil-Vorschau …" Command="{Binding DataContext.PreviewProfileCommand, RelativeSource={RelativeSource AncestorType=c:PageLayout}}" CommandParameter="{Binding}"
                            ToolTip="Zeigt, was das Profil ändern würde, und wendet es nach Bestätigung jetzt an." />
                    <TextBlock Style="{StaticResource Text.CardTitle}"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Platform, Mode=OneWay}" /></TextBlock>
                </DockPanel>
                <TextBlock Text="{Binding Executables}" Style="{StaticResource Text.Caption}" Margin="0,2,0,8" />
                <WrapPanel>
                    <CheckBox Content="Automatisch beim Spielstart aktivieren" IsChecked="{Binding AutoActivate}" IsEnabled="{Binding HasExecutables}" Margin="0,0,20,6" />
                    <CheckBox Content="Nur im Netzbetrieb" IsChecked="{Binding OnlyOnAc}" Margin="0,0,20,6" />
                    <CheckBox Content="Leistungsplan „Hohe Leistung“ nutzen" IsChecked="{Binding UsePowerPlan}" Margin="0,0,20,6" ToolTip="Nur im Netzbetrieb und ohne beobachtete thermische Drosselung." />
                    <CheckBox Content="Beim Beenden wiederherstellen" IsChecked="{Binding RestoreOnExit}" Margin="0,0,20,6" />
                    <CheckBox Content="Sitzung aufzeichnen" IsChecked="{Binding RecordSession}" Margin="0,0,20,6" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Priorität:" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="190" Margin="0,0,20,0" SelectedValue="{Binding Priority}" SelectedValuePath="Value" DisplayMemberPath="Label"
                              ItemsSource="{Binding DataContext.Priorities, RelativeSource={RelativeSource AncestorType=c:PageLayout}}" AutomationProperties.Name="Prozesspriorität" />
                    <TextBlock Text="GPU:" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="250" SelectedValue="{Binding GpuPreference}" SelectedValuePath="Value" DisplayMemberPath="Label"
                              ItemsSource="{Binding DataContext.GpuPreferences, RelativeSource={RelativeSource AncestorType=c:PageLayout}}" AutomationProperties.Name="GPU-Präferenz" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SessionRow}">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Visibility="{Binding Note, Converter={StaticResource Vis}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:GamingViewModel}">
        <c:PageLayout>
            <c:PageLayout.HeaderContent>
                <Button Content="Spiele neu suchen" Command="{Binding RescanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource Not}}" />
            </c:PageLayout.HeaderContent>
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="{Binding AutoMode}" Content="Automatischer Gaming-Modus" />
                        <TextBlock Text="{Binding CurrentText}" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FrameStatus}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card.Note}" Margin="0,0,0,12">
                    <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"
                               Text="Gaming-Boost verspricht keine höheren Bildraten. Er wendet nur belegte, umkehrbare Einstellungen an (Energieplan im Netzbetrieb, Prioritäten, GPU-Zuordnung) und zeigt die Messwerte der Sitzung. Prozesse werden nie ohne Ihre Entscheidung beendet." />
                </Border>
                <TextBlock Text="Spiele und Profile" Style="{StaticResource Text.Section}" Margin="0,4,0,6" />
                <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,10" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Games}" Style="{StaticResource Items.Cards}" />
                <TextBlock Text="Letzte Sitzungen" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Noch keine aufgezeichneten Sitzungen." Style="{StaticResource Text.Secondary}" Visibility="{Binding Sessions.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding Sessions}" Focusable="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </c:PageLayout>
    </DataTemplate>
</ResourceDictionary>
